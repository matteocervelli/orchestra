  "assets": [],
  "dependency_free_scopes": [],
  "exclusions": [
    ".git",
    ".mypy_cache",
    ".pytest_cache",
    ".ruff_cache",
    ".venv",
    ".worktrees",
    "__pycache__",
    "build",
    "dist",
    "node_modules"
  ],
  "limits": {
    "aggregate_bytes": 67108864,
    "blob_bytes": 4194304,
    "envelope_bytes": 65536,
    "export_seconds": 60,
    "file_bytes": 65536,
    "file_count": 10000,
    "finding_count": 128,
    "gap_count": 128,
    "manifest_count": 256,
    "native_seconds": 300,
    "native_stderr_bytes": 65536,
    "native_stdout_bytes": 65536,
    "probe_bytes": 4096,
    "probe_seconds": 10,
    "receipt_count": 128,
    "request_bytes": 2097152,
    "root_count": 64,
    "scan_seconds": 3600,
    "yaml_depth": 32,
    "yaml_nodes": 100000
  },
  "policy": "orchestra-high-block-v1",
  "profile_id": "orchestra-pilot-v1",
  "schema": "orchestra.security-profile/v1",
  "source_bindings": {
    "grammar": "uv1-r3/pnpm9/npm3-v1",
    "js_overrides": [
