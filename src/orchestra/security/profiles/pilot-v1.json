        "devDependencies",
        "vite",
        "^6",
        "vite@>=6 <7",
        "6.4.4",
        "6.4.4"
      ]
    ],
    "js_registry": "https://registry.npmjs.org",
    "private_indexes": [
      "https://git.adlimen.dev/api/packages/adlimen/pypi/simple/"
    ],
    "public_index": "https://pypi.org/simple",
    "python_ranges": [
      [
        "adlimen-orchestra",
        ">=3.12,<3.13",
        "==3.12.*"
      ]
    ]
  }
