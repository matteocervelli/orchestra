"import { countable } from \"./cb-counts.js\";\n\n// Toolbar pieces (himalaia CatalogFilterBar / CatalogActiveFilters / CatalogSortMenu) in adlimen-ui classes.\nimport { h } from \"./cb-util.js\";\nimport { CALL_KINDS } from \"./cb-bits.js\";\nimport { PRIORITIES } from \"./cb-priority.js\";\nimport {\n  state,\n  SORT_FIELDS,\n  TOGGLES,\n  GROUPS,\n  PREDICATES,\n  matchOption,\n  activeFilterCount,\n  facetCounts,\n  facetValue,\n  toggleCount,\n  callSummary,\n  activeFilters,\n  countSummary,\n  FACET_LABEL,\n  TOGGLE_LABEL,\n  filterValueLabel,\n} from \"./cb-state.js\";\nimport { FIELDS, serializeFields } from \"./v3/fields.js\";\n\nconst FACET_ALL = {\n  repo: \"Tutti i repo\",\n  status: \"Tutti gli stati\",\n  call: \"Tutti i tipi di richiesta\",\n  priority: \"Tutte le priorità\",\n};\nconst FACET_SEARCH = {\n  repo: \"Cerca repo…\",\n  status: \"Cerca stato…\",\n  call: \"Cerca tipo…\",\n  priority: \"Cerca priorità…\",\n};\nconst valueLabel = filterValueLabel;\n\nfunction options(items, facet, statuses) {\n  const values = [...new Set(items.map((it) => facetValue(it, facet)).filter(Boolean))];\n  if (facet === \"status\")\n    values.sort((a, b) => statuses.indexOf(a) - statuses.indexOf(b));\n  else if (facet === \"call\")\n    values.sort((a, b) => CALL_KINDS.indexOf(a) - CALL_KINDS.indexOf(b));\n  else if (facet === \"priority\")\n    values.sort((a, b) => PRIORITIES.indexOf(a) - PRIORITIES.indexOf(b));\n  else\n    values.sort((a, b) =>\n      valueLabel(facet, a).localeCompare(valueLabel(facet, b), \"it\", {\n        numeric: true,\n      }),\n    );\n  const counts = facetCounts(items, facet);\n  return values.map((v) => ({\n    value: v,\n    label: valueLabel(facet, v),\n    count: counts.get(v) || 0,\n    summary: countSummary(counts.get(v) || 0, items.filter(it => (facet === \"status\" ? !it.hidden : countable(it)) && (facet === \"repo\" ? (it.repos?.length ? it.repos : [it.repo]).includes(v) : facetValue(it, facet) === v)).length, state, facet).label,\n  }));\n}\n\n// Hide the options that do not match the panel's search box, in place (the caret stays put).\nexport function applyMsQuery(panel, q) {\n  let shown = 0;\n  for (const o of panel.querySelectorAll(\"[data-ms-label]\")) {\n    o.hidden = !matchOption(o.dataset.msLabel, q);\n    if (!o.hidden) shown++;\n  }\n  const empty = panel.querySelector(\".al-multi-select__empty\");\n  if (empty) empty.hidden = shown > 0;\n}\n\nfunction multiSelect(facet, opts, ui, alignEnd) {\n  const sel = state[facet];\n  const open = ui.openMenu === facet;\n  const q = ui.msQuery?.[facet] || \"\";\n  const panelId = `cb-ms-${facet}`;\n  return h(\n    \"div\",\n    { class: \"al-multi-select\" },\n    h(\n      \"button\",\n      {\n        type: \"button\",\n        class: `al-multi-select__trigger${sel.length ? \" al-multi-select__trigger--active\" : \"\"}`,\n        \"aria-expanded\": String(open),\n        \"aria-controls\": panelId,\n        \"data-action\": \"ms-toggle\",\n        \"data-facet\": facet,\n        \"data-key\": `ms:${facet}`,\n      },\n      h(\n        \"span\",\n        { class: \"al-multi-select__trigger-label\" },\n        FACET_LABEL[facet],\n      ),\n      sel.length\n        ? h(\"span\", { class: \"al-multi-select__count\" }, sel.length)\n        : null,\n    ),\n    h(\n      \"div\",\n      {\n        id: panelId,\n        class: `al-multi-select__panel${alignEnd ? \" al-multi-select__panel--end\" : \"\"}`,\n        role: \"group\",\n        \"aria-label\": FACET_LABEL[facet],\n        hidden: !open,\n      },\n      h(\"input\", {\n        type: \"search\",\n        class: \"al-multi-select__search\",\n        placeholder: FACET_SEARCH[facet],\n        \"aria-label\": `Cerca ${FACET_LABEL[facet].toLowerCase()}`,\n        autocomplete: \"off\",\n        value: q,\n        \"data-ms-search\": facet,\n        \"data-key\": `mss:${facet}`,\n      }),\n      h(\n        \"button\",\n        {\n          type: \"button\",\n          \"data-action\": \"ms-all\",\n          \"data-facet\": facet,\n          \"data-key\": `all:${facet}`,\n          class: `al-multi-select__option al-multi-select__option--check${sel.length ? \"\" : \" al-multi-select__option--selected\"}`,\n        },\n        h(\"span\", { class: \"al-multi-select__option-label\" }, FACET_ALL[facet]),\n        h(\n          \"span\",\n          { class: \"al-multi-select__option-check\", \"aria-hidden\": \"true\" },\n          sel.length ? \"\" : \"✓\",\n        ),\n      ),\n      opts.map((o) =>\n        h(\n          \"label\",\n          {\n            class: \"al-form-check al-multi-select__option\",\n            \"data-ms-label\": o.label,\n            hidden: !matchOption(o.label, q),\n          },\n          h(\"input\", {\n            type: \"checkbox\",\n            class: \"al-form-check__input\",\n            checked: sel.includes(o.value),\n            \"data-facet\": facet,\n            \"data-value\": o.value,\n            \"data-key\": `opt:${facet}:${o.value}`,\n          }),\n          h(\"span\", { class: \"al-form-check__label\" }, o.label),\n          h(\n            \"span\",\n            { class: \"cb-facet\", \"aria-label\": `${o.summary} elementi`, title: o.summary },\n            o.count,\n          ),\n        ),\n      ),\n      h(\n        \"p\",\n        {\n          class: \"al-multi-select__empty\",\n          hidden: opts.some((o) => matchOption(o.label, q)),\n        },\n        \"Nessun risultato\",\n      ),\n    ),\n  );\n}\n\nfunction toggle(key, label, count) {\n  return h(\n    \"label\",\n    { class: \"al-toggle al-toggle--sm\" },\n    h(\"input\", {\n      type: \"checkbox\",\n      class: \"al-toggle__input\",\n      checked: state[key],\n      \"data-toggle\": key,\n      \"data-key\": `tg:${key}`,\n    }),\n    h(\n      \"span\",\n      { class: \"al-toggle__track\", \"aria-hidden\": \"true\" },\n      h(\"span\", { class: \"al-toggle__thumb\" }),\n    ),\n    h(\"span\", { class: \"al-toggle__label\" }, `${label} (${count})`),\n  );\n}\n\nexport function renderFilterStrip(el, items, statuses, ui) {\n  el.hidden = !ui.filtersOpen;\n  if (!ui.filtersOpen) {\n    el.replaceChildren();\n    return;\n  }\n  el.replaceChildren(\n    multiSelect(\"repo\", options(items, \"repo\", statuses), ui, false),\n    multiSelect(\"status\", options(items, \"status\", statuses), ui, false),\n    multiSelect(\"call\", options(items, \"call\", statuses), ui, false),\n    multiSelect(\"priority\", options(items, \"priority\", statuses), ui, false),\n    ...TOGGLES.map((t) => toggle(t, TOGGLE_LABEL[t], toggleCount(items, t, PREDICATES[t]))),\n    h(\n      \"button\",\n      {\n        type: \"button\",\n        class: \"al-btn al-btn--ghost al-btn--sm\",\n        \"data-action\": \"reset\",\n        \"data-key\": \"reset-strip\",\n      },\n      \"Reimposta\",\n    ),\n  );\n}\n\nfunction pill(label, facet, value) {\n  return h(\n    \"span\",\n    { class: \"al-table-filter-chip\" },\n    h(\"span\", { class: \"al-table-filter-chip__label\" }, label),\n    h(\n      \"button\",\n      {\n        type: \"button\",\n        class: \"al-table-filter-chip__dismiss\",\n        \"aria-label\": `Rimuovi filtro ${label}`,\n        \"data-action\": \"pill-remove\",\n        \"data-facet\": facet,\n        \"data-value\": value ?? \"\",\n        \"data-key\": `pill:${facet}:${value ?? \"\"}`,\n      },\n      \"×\",\n    ),\n  );\n}\n\nexport function renderPills(el) {\n  const pills = activeFilters().map(({ label, facet, value }) => pill(label, facet, value));\n  el.hidden = pills.length === 0;\n  if (pills.length) {\n    pills.push(\n      h(\n        \"button\",\n        {\n          type: \"button\",\n          class: \"al-btn al-btn--ghost al-btn--sm\",\n          \"data-action\": \"reset\",\n          \"data-key\": \"reset-pills\",\n        },\n        \"Azzera filtri\",\n      ),\n    );\n  }\n  el.replaceChildren(...pills);\n}\n\nexport function renderFilterButton(btn, countEl, ui) {\n  const n = activeFilterCount();\n  btn.classList.toggle(\n    \"al-data-view-toolbar__control--active\",\n    ui.filtersOpen || n > 0,\n  );\n  btn.setAttribute(\"aria-expanded\", String(ui.filtersOpen));\n  countEl.hidden = n === 0;\n  countEl.textContent = String(n);\n}\n\nexport function renderSortMenu(content, countEl) {\n  countEl.textContent = String(state.sort.length);\n  const rows = state.sort.map((r, i) =>\n    h(\n      \"div\",\n      { class: \"cb-sort-rule\" },\n      h(\n        \"span\",\n        { class: \"cb-sort-rule__label\" },\n        `${i + 1}. ${SORT_FIELDS[r.f]}`,\n      ),\n      h(\n        \"button\",\n        {\n          type: \"button\",\n          class: \"al-btn al-btn--outline al-btn--sm\",\n          \"data-action\": \"sort-dir\",\n          \"data-idx\": i,\n          \"data-key\": `sdir:${r.f}`,\n          \"aria-label\": `${SORT_FIELDS[r.f]}: ${r.d === \"asc\" ? \"crescente\" : \"decrescente\"}, inverti`,\n        },\n        r.d === \"asc\" ? \"Crescente ↑\" : \"Decrescente ↓\",\n      ),\n      h(\n        \"button\",\n        {\n          type: \"button\",\n          class: \"al-btn al-btn--ghost al-btn--sm\",\n          \"data-action\": \"sort-remove\",\n          \"data-idx\": i,\n          \"data-key\": `srm:${r.f}`,\n          \"aria-label\": `Rimuovi ordinamento per ${SORT_FIELDS[r.f]}`,\n        },\n        \"×\",\n      ),\n    ),\n  );\n  const used = new Set(state.sort.map((r) => r.f));\n  const add =\n    state.sort.length >= 3\n      ? []\n      : Object.entries(SORT_FIELDS)\n          .filter(([f]) => !used.has(f))\n          .map(([f, label]) =>\n            h(\n              \"button\",\n              {\n                type: \"button\",\n                class: \"al-data-view-toolbar__menu-item\",\n                \"data-action\": \"sort-add\",\n                \"data-field\": f,\n                \"data-key\": `sadd:${f}`,\n              },\n              `Aggiungi ${label}`,\n            ),\n          );\n  content.replaceChildren(\n    ...[\n    h(\n      \"div\",\n      { class: \"al-data-view-toolbar__menu-title\" },\n      \"Priorità di ordinamento\",\n    ),\n    rows.length\n      ? rows\n      : h(\n          \"p\",\n          { class: \"cb-muted\" },\n          \"Ordine predefinito: priorità, poi aggiornato.\",\n        ),\n    add.length\n      ? h(\n          \"div\",\n          { class: \"al-data-view-toolbar__menu-title\" },\n          \"Aggiungi regola (max 3)\",\n        )\n      : null,\n    add,\n    h(\n      \"button\",\n      {\n        type: \"button\",\n        class: \"al-data-view-toolbar__menu-item\",\n        \"data-action\": \"sort-clear\",\n        \"data-key\": \"sclear\",\n      },\n      \"Azzera ordinamento\",\n    ),\n    ].flat().filter(Boolean),\n  );\n}\n\n// Quick \"Your call\" flag next to Filtri: the same number as the strip's «Tutto» (callSummary).\nexport function renderYourCallButton(btn, countEl, items) {\n  const sum = callSummary(items);\n  btn.setAttribute(\"aria-pressed\", String(state.yourcall));\n  btn.setAttribute(\"title\", `Your call: ${sum.label}`);\n  btn.classList.toggle(\"al-data-view-toolbar__control--active\", state.yourcall);\n  countEl.textContent = sum.text;\n}\n\n// «Da fare tu» next to Your call: items with a task for Matteo (or a Fatto waiting), across repos.\nexport function renderTodoButton(btn, countEl, items) {\n  btn.setAttribute(\"aria-pressed\", String(state.todo));\n  btn.classList.toggle(\"al-data-view-toolbar__control--active\", state.todo);\n  const sum = countSummary(toggleCount(items, \"todo\", PREDICATES.todo), items.filter(it => countable(it) && PREDICATES.todo(it)).length, state, \"todo\");\n  btn.setAttribute(\"title\", `Da fare tu: ${sum.label}`);\n  countEl.textContent = sum.filtered ? sum.label : sum.text;\n}\n\n// \"Raggruppa\" menu (himalaia GroupControl): one pressed button per grouping.\nexport function renderGroupMenu(content, countEl) {\n  countEl.hidden = state.group === \"none\";\n  countEl.textContent = \"1\";\n  content.replaceChildren(\n    h(\"div\", { class: \"al-data-view-toolbar__menu-title\" }, \"Raggruppa per\"),\n    ...Object.entries(GROUPS).map(([key, label]) =>\n      h(\n        \"button\",\n        {\n          type: \"button\",\n          class: \"al-data-view-toolbar__menu-item\",\n          \"data-action\": \"group-set\",\n          \"data-group\": key,\n          \"data-key\": `group:${key}`,\n          \"aria-pressed\": String(state.group === key),\n        },\n        label,\n        state.group === key\n          ? h(\"span\", { class: \"v3-group__check\", \"aria-hidden\": \"true\" }, \"✓\")\n          : null,\n      ),\n    ),\n  );\n}\n\n// «Campi visibili»: one checkbox per card field (board cards and table columns), reset to default.\nexport function renderFieldsMenu(content, countEl) {\n  const custom = serializeFields(state.fields) !== \"\";\n  countEl.hidden = !custom;\n  countEl.textContent = `${state.fields.size}/${FIELDS.length}`;\n  const parts = [\n    h(\"div\", { class: \"al-data-view-toolbar__menu-title\", id: \"cb-fields-title\" }, \"Campi visibili\"),\n    h(\n      \"div\",\n      { class: \"v3-fields\", role: \"group\", \"aria-labelledby\": \"cb-fields-title\" },\n      FIELDS.map((f) =>\n        h(\n          \"label\",\n          { class: \"v3-fields__opt\" },\n          h(\"input\", {\n            type: \"checkbox\",\n            \"data-field\": f.key,\n            \"data-key\": `field:${f.key}`,\n            checked: state.fields.has(f.key),\n          }),\n          h(\"span\", null, f.label),\n        ),\n      ),\n    ),\n    h(\"p\", { class: \"v3-fields__hint\" }, \"Board e tabella. La scelta è nel link; senza parametri si usano i campi predefiniti.\"),\n    custom\n      ? h(\n          \"button\",\n          {\n            type: \"button\",\n            class: \"al-btn al-btn--outline al-btn--sm\",\n            \"data-action\": \"fields-reset\",\n            \"data-key\": \"fields-reset\",\n          },\n          \"Ripristina predefiniti\",\n        )\n      : null,\n  ];\n  content.replaceChildren(...parts.filter(Boolean)); // replaceChildren(null) would print \"null\"\n}\n\n"
